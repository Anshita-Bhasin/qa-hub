# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE_URL: Your Supabase project's API URL.
# Find it at Supabase Dashboard > Settings > Data API > Project URL.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# SUPABASE_SECRET_KEY: The service-role (secret) key — server-only, bypasses
# Row Level Security. Never expose this to the frontend or commit a real value.
# Find it at Supabase Dashboard > Settings > Data API > Project API keys (service_role).
SUPABASE_SECRET_KEY="MY_SUPABASE_SECRET_KEY"

# JIRA_BASE_URL: Your Jira Cloud site URL (no trailing slash).
JIRA_BASE_URL="https://YOUR_SITE.atlassian.net"

# JIRA_EMAIL: The Atlassian account email associated with the API token below.
JIRA_EMAIL="you@example.com"

# JIRA_API_TOKEN: A Jira Cloud API token — server-only, never expose this to
# the frontend or commit a real value. Create one at
# https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_API_TOKEN="MY_JIRA_API_TOKEN"

# JIRA_PROJECT_KEY: The Jira project key issues should be created under (e.g. "KAN").
JIRA_PROJECT_KEY="MY_JIRA_PROJECT_KEY"
